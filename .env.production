# Production Environment Configuration
# IMPORTANT: Update all values marked with "CHANGE-ME" before deployment!

# Neon PostgreSQL Configuration
DATABASE_TYPE=neon
DATABASE_URL=postgresql://neondb_owner:npg_x6NbtJnw2pGj@ep-morning-pond-ah8x5zco-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_POOL_SIZE=20
