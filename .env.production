# Application Settings
APP_ENV=production
LOG_LEVEL=WARNING
CACHE_DURATION_MINUTES=15

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Security Settings (Production - Strict)
# Admin access is completely DISABLED in production
ENABLE_ADMIN_ENDPOINTS=false
REQUIRE_ADMIN_AUTH=true
ENABLE_OWNERSHIP_ENDPOINTS=true
ENABLE_DOCS=false
STRICT_CORS=true

# Production Notes:
# 1. Admin endpoints are COMPLETELY DISABLED for maximum security
# 2. Admin functionality is not available in production
# 3. API documentation is DISABLED
# 4. Public read-only access only
# 5. Ownership endpoints require authentication